# Copia este archivo como .env (git lo ignora) y completa tus datos de DagsHub.
# Sin estas variables, el pipeline registra en la base local mlflow.db.
# Para cargarlas en la terminal:  set -a && source .env && set +a
MLFLOW_TRACKING_URI=https://dagshub.com/jeffangeloss/mlops-phishing.mlflow
MLFLOW_TRACKING_USERNAME=jeffangeloss
MLFLOW_TRACKING_PASSWORD=<token de DagsHub>
